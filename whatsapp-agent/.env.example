PORT=3333

# From console.anthropic.com
ANTHROPIC_API_KEY=
# Optional. Default: claude-sonnet-4-5
ANTHROPIC_MODEL=

# Chatwoot instance (no trailing slash needed)
CHATWOOT_BASE_URL=https://your-chatwoot-instance.com
# Use the Agent Bot's own access token (Settings > Integrations > Bots) so replies show up
# as the bot. A user token (Profile Settings > Access Token) also works.
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_ACCOUNT_ID=

# Random string (e.g. `openssl rand -hex 24`). Must also be appended to the Agent Bot's
# webhook URL:  https://<this-service>/webhook/chatwoot?token=<WEBHOOK_SECRET>
WEBHOOK_SECRET=

# Laís's real OAB registration, e.g. "OAB/DF nº 12.345". REQUIRED when NODE_ENV=production.
OAB_NUMBER=

# Contract cap of automated conversations per month (only logs a warning when exceeded)
MONTHLY_CONVERSATION_CAP=100
# Hand off to a human after this many client messages even if triage did not finish
MAX_USER_MESSAGES=12
# Where monthly usage counters are kept
USAGE_FILE=./data/usage.json
